{
  "name": "weightscope",
  "displayName": "WeightScope — Safetensors, GGUF & Checkpoint Inspector",
  "description": "Inspect model layers, tensor health, precision and checkpoint drift locally, on demand.",
  "version": "0.4.2",
  "publisher": "weightscope-local",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maria-rjn/Weightscope.git"
  },
  "homepage": "https://github.com/maria-rjn/Weightscope#readme",
  "bugs": {
    "url": "https://github.com/maria-rjn/Weightscope/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "safetensors",
    "sharded",
    "huggingface",
    "checkpoint",
    "gguf",
    "onnx",
    "pytorch",
    "ollama",
    "tensor",
    "weights",
    "llm",
    "quantization",
    "model viewer"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Native model readers work in Restricted Mode. PyTorch inspection requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCustomEditor:weightscope.inspector"
  ],
  "contributes": {
    "commands": [
      {
        "command": "weightscope.open",
        "title": "WeightScope: Inspect Model"
      },
      {
        "command": "weightscope.openOllama",
        "title": "WeightScope: Open Ollama Model"
      },
      {
        "command": "weightscope.compareOllama",
        "title": "WeightScope: Compare Ollama Models"
      },
      {
        "command": "weightscope.compare",
        "title": "WeightScope: Compare Checkpoints"
      },
      {
        "command": "weightscope.setup",
        "title": "WeightScope: PyTorch Setup Instructions"
      }
    ],
    "customEditors": [
      {
        "viewType": "weightscope.inspector",
        "displayName": "WeightScope",
        "selector": [
          {
            "filenamePattern": "*.safetensors"
          },
          {
            "filenamePattern": "*.gguf"
          },
          {
            "filenamePattern": "*.onnx"
          },
          {
            "filenamePattern": "*.pt"
          },
          {
            "filenamePattern": "*.pth"
          },
          {
            "filenamePattern": "*.safetensors.index.json"
          },
          {
            "filenamePattern": "**/manifests/*/*/*/*"
          },
          {
            "filenamePattern": "*.bin.index.json"
          },
          {
            "filenamePattern": "*-[0-9]*-of-[0-9]*.bin"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "weightscope",
          "title": "WeightScope",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "weightscope": [
        {
          "id": "weightscope.start",
          "name": "Start",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "weightscope.start",
        "contents": "Inspect a local checkpoint: .safetensors, .gguf, .onnx, .pt, .pth, or a sharded Hugging Face index.\n[Inspect Model File…](command:weightscope.open)\nOpen a model you downloaded with Ollama. Ollama does not need to be running.\n[Open Ollama Model…](command:weightscope.openOllama)\nCompare a baseline with a target to see which tensors changed.\n[Compare Checkpoints…](command:weightscope.compare)\n[Compare Ollama Models…](command:weightscope.compareOllama)\nYou can also open a model file from the Explorer. PyTorch .pt and .pth files need a trusted workspace and [Python with PyTorch](command:weightscope.setup)."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "weightscope.open",
          "when": "resourceExtname =~ /\\.(safetensors|gguf|onnx|pt|pth)$/ || resourceFilename =~ /\\.(safetensors|bin)\\.index\\.json$/ || resourceFilename =~ /-[0-9]+-of-[0-9]+\\.bin$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WeightScope",
      "properties": {
        "weightscope.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python executable with PyTorch >= 2.6 installed. Empty uses python3 (or py -3 on Windows). Only needed for .pt/.pth."
        },
        "weightscope.sampleSize": {
          "type": "integer",
          "default": 32768,
          "minimum": 256,
          "maximum": 262144,
          "description": "Maximum values sampled per tensor. Small tensors are analyzed in full; large tensors use evenly spaced windows."
        },
        "weightscope.maxDiffTensors": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum compatible tensors analyzed per batch comparison. Individual rows can always be analyzed."
        },
        "weightscope.absoluteTolerance": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Absolute tolerance when classifying numerical checkpoint differences."
        },
        "weightscope.ollamaModelsPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Ollama models directory containing manifests and blobs. Empty uses OLLAMA_MODELS or the default local store. For Remote SSH, set the path on the remote host."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "demo": "node scripts/make-demo.js",
    "preview": "node scripts/preview.js",
    "screenshots": "node scripts/screenshots.js",
    "package": "node scripts/package.js",
    "test:integration": "node --test test/integration.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
